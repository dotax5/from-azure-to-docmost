# Azure DevOps
AZURE_ORG=ORG
AZURE_PROJECT=Projects
AZURE_WIKI_REPO=Projects.wiki
# Create PAT: https://dev.azure.com/{org}/_usersSettings/tokens (Code -> Read and Wiki -> Read)
AZURE_PAT=PAT

# Docmost
DOCMOST_URL=http://localhost:3000
# Create in Docmost: Settings -> API keys (under Account) -> Create API Key
DOCMOST_API_KEY=API


# Paths (WIKI_SOURCE_PATH empty = entire wiki)
WIKI_SOURCE_PATH="folder1/folder2/information.md"
WIKI_DEST_PATH="Space/folder1/folder2"

# sort_branch.py: page path whose direct children should be sorted alphabetically
SORT_BRANCH_PATH="Space/Vendors"
# also recursively sort every nested sub-branch under SORT_BRANCH_PATH
SORT_RECURSIVE=false